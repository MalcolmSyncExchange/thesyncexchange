  "constraints": [
    {
      "name": "tracks_approved_by_fkey",
      "table": "tracks",
      "definition": "FOREIGN KEY (approved_by) REFERENCES auth.users(id) ON DELETE SET NULL NOT VALID"
    },
    {
      "name": "tracks_artist_user_id_fkey",
      "table": "tracks",
      "definition": "FOREIGN KEY (artist_user_id) REFERENCES auth.users(id) ON DELETE CASCADE NOT VALID"
    },
    {
      "name": "tracks_bpm_check",
      "table": "tracks",
      "definition": "CHECK (((bpm >= 0) AND (bpm <= 300)))"
    },
    {
      "name": "tracks_duration_seconds_check",
      "table": "tracks",
      "definition": "CHECK (((duration_seconds >= 1) AND (duration_seconds <= 3600)))"
    },
    {
      "name": "tracks_pkey",
      "table": "tracks",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "tracks_release_year_check",
      "table": "tracks",
      "definition": "CHECK (((release_year >= 1900) AND (release_year <= 2100)))"
    },
    {
      "name": "tracks_slug_key",
      "table": "tracks",
      "definition": "UNIQUE (slug)"
    },
    {
      "name": "tracks_vocal_consistency_check",
      "table": "tracks",
      "definition": "CHECK ((NOT (instrumental AND vocals)))"
    },
    {
      "name": "rights_holders_ownership_percent_check",
      "table": "rights_holders",
      "definition": "CHECK (((ownership_percent > (0)::numeric) AND (ownership_percent <= (100)::numeric)))"
    },
    {
      "name": "rights_holders_pkey",
      "table": "rights_holders",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "rights_holders_role_type_check",
      "table": "rights_holders",
      "definition": "CHECK ((role_type = ANY (ARRAY['writer'::text, 'producer'::text, 'publisher'::text, 'owner'::text, 'other'::text])))"
    },
    {
      "name": "rights_holders_track_id_fkey",
      "table": "rights_holders",
      "definition": "FOREIGN KEY (track_id) REFERENCES tracks(id) ON DELETE CASCADE"
    },
    {
      "name": "rights_holders_user_id_fkey",
      "table": "rights_holders",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE SET NULL NOT VALID"
    },
    {
      "name": "orders_amount_cents_check",
      "table": "orders",
      "definition": "CHECK ((amount_cents >= 0))"
    },
    {
      "name": "orders_buyer_user_id_fkey",
      "table": "orders",
      "definition": "FOREIGN KEY (buyer_user_id) REFERENCES auth.users(id) ON DELETE CASCADE NOT VALID"
    },
    {
      "name": "orders_currency_check",
      "table": "orders",
      "definition": "CHECK (((char_length(currency) = 3) AND (currency = upper(currency))))"
    },
    {
      "name": "orders_license_type_id_fkey",
      "table": "orders",
      "definition": "FOREIGN KEY (license_type_id) REFERENCES license_types(id)"
    },
    {
      "name": "orders_pkey",
      "table": "orders",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "orders_track_id_fkey",
      "table": "orders",
      "definition": "FOREIGN KEY (track_id) REFERENCES tracks(id)"
    },
    {
